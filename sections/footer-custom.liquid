{%- liquid
  assign accordions = section.blocks | where: 'type', 'accordion'
  assign security_badges = section.blocks | where: 'type', 'security_badge'
  assign payment_badges = section.blocks | where: 'type', 'payment_badge'
-%}

<div class="footer-custom" style="background-color: {{ section.settings.background_color }};">
  <div class="footer-custom__container page-width">

    {%- if section.settings.use_newsletter -%}
      <div class="footer-custom__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="footer-custom__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_subtext != blank -%}
          <div class="footer-custom__newsletter-subtext">{{ section.settings.newsletter_subtext }}</div>
        {%- endif -%}

        {%- form 'customer', class: 'footer-custom__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            type="email"
            name="contact[email]"
            class="footer-custom__newsletter-input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.newsletter_placeholder }}"
            aria-label="{{ section.settings.newsletter_placeholder }}"
            required
          >
          <button type="submit" class="footer-custom__newsletter-submit">
            {{ section.settings.newsletter_button_label }}
          </button>
          {%- if form.posted_successfully? -%}
            <p class="footer-custom__newsletter-thanks">{{ section.settings.newsletter_thanks_text }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="footer-custom__right">
      {%- if section.settings.logo != blank -%}
        <a href="/" class="footer-custom__logo">
          <img
            src="{{ section.settings.logo | image_url: width: 600 }}"
            alt="{{ section.settings.logo.alt | default: shop.name }}"
            width="{{ section.settings.logo_width }}"
            loading="lazy"
          >
        </a>
      {%- endif -%}

      {%- if accordions.size > 0 -%}
        <div class="footer-custom__accordions">
          {%- for block in accordions -%}
            <details class="footer-custom__accordion" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.title }}</span>
                <span class="footer-custom__chevron" aria-hidden="true">
                  <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </summary>
              <div class="footer-custom__accordion-content">
                {%- if block.settings.menu != blank -%}
                  <ul class="footer-custom__link-list">
                    {%- for link in linklists[block.settings.menu].links -%}
                      <li>{{ link.title | link_to: link.url }}</li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer-custom__accordion-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        <div class="footer-custom__social">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="20" height="20"><path fill="currentColor" d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
              <svg role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.whatsapp != blank -%}
            <a href="{{ section.settings.whatsapp }}" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="20" height="20"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook != blank -%}
            <a href="{{ section.settings.facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
              <svg role="img" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="20" height="20"><path fill="currentColor" d="M18.375 9.375C18.375 4.404 14.346.375 9.375.375S.375 4.404.375 9.375c0 4.492 3.291 8.216 7.594 8.891V11.977H5.684V9.375h2.285V7.392c0-2.256 1.344-3.502 3.4-3.502.984 0 2.014.176 2.014.176v2.215h-1.135c-1.118 0-1.467.694-1.467 1.406v1.688h2.496l-.399 2.602h-2.097v6.289c4.303-.675 7.594-4.399 7.594-8.891z"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- if security_badges.size > 0 or payment_badges.size > 0 -%}
      <div class="footer-custom__trust">
        {%- if security_badges.size > 0 -%}
          <div class="footer-custom__trust-group">
            {%- if section.settings.security_heading != blank -%}
              <h3 class="footer-custom__trust-heading">{{ section.settings.security_heading }}</h3>
            {%- endif -%}
            <div class="footer-custom__trust-row">
              {%- for block in security_badges -%}
                {%- if block.settings.image != blank -%}
                  <img
                    class="footer-custom__trust-badge"
                    src="{{ block.settings.image | image_url: width: 160 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.text }}"
                    loading="lazy"
                    {{ block.shopify_attributes }}
                  >
                {%- else -%}
                  <span
                    class="footer-custom__trust-badge footer-custom__trust-badge--text"
                    style="background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.icon != blank -%}{{ block.settings.icon }} {%- endif -%}{{ block.settings.text }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if payment_badges.size > 0 or section.settings.show_native_payment_icons -%}
          <div class="footer-custom__trust-group">
            {%- if section.settings.payment_heading != blank -%}
              <h3 class="footer-custom__trust-heading">{{ section.settings.payment_heading }}</h3>
            {%- endif -%}
            <div class="footer-custom__trust-row">
              {%- if section.settings.show_native_payment_icons -%}
                {%- for type in shop.enabled_payment_types -%}
                  <span class="footer-custom__trust-badge footer-custom__trust-badge--native">{{ type | payment_type_svg_tag }}</span>
                {%- endfor -%}
              {%- endif -%}
              {%- for block in payment_badges -%}
                {%- if block.settings.image != blank -%}
                  <img
                    class="footer-custom__trust-badge"
                    src="{{ block.settings.image | image_url: width: 160 }}"
                    alt="{{ block.settings.image.alt | default: block.settings.text }}"
                    loading="lazy"
                    {{ block.shopify_attributes }}
                  >
                {%- else -%}
                  <span
                    class="footer-custom__trust-badge footer-custom__trust-badge--text"
                    style="background: {{ block.settings.bg_color }}; color: {{ block.settings.text_color }};"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer-custom__bottom">
      {%- if section.settings.copyright_text != blank -%}
        <div class="footer-custom__copyright">{{ section.settings.copyright_text }}</div>
      {%- endif -%}
      {%- if section.settings.policies_link_label != blank -%}
        <a href="{{ section.settings.policies_link_url | default: '#' }}" class="footer-custom__policies-link">
          {{ section.settings.policies_link_label }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
.footer-custom {
  padding: 32px 0 24px;
}

.footer-custom__container {
  max-width: 560px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-custom__newsletter {
  width: 100%;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 16px;
  padding: 32px 24px;
  margin-bottom: 24px;
}

.footer-custom__right {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-custom__newsletter-heading {
  font-size: 1.6rem;
  font-weight: 800;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin: 0 0 12px;
  color: #1a1a1a;
}

.footer-custom__newsletter-subtext {
  font-size: 1.05rem;
  font-weight: 700;
  color: #666;
  margin: 0 0 20px;
  line-height: 1.5;
}

.footer-custom__newsletter-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
  max-width: 380px;
  margin: 0 auto;
}

.footer-custom__newsletter-input {
  width: 100%;
  box-sizing: border-box;
  padding: 14px 18px;
  border-radius: 999px;
  border: 1px solid rgba(0, 0, 0, 0.12);
  background: #fff;
  font-size: 0.95rem;
}

.footer-custom__newsletter-input:focus {
  outline: none;
  border-color: #e5007e;
}

.footer-custom__newsletter-submit {
  width: 100%;
  padding: 14px 18px;
  border-radius: 999px;
  border: 0;
  background: #e5007e;
  color: #fff;
  font-weight: 700;
  font-size: 0.95rem;
  cursor: pointer;
  transition: background 0.2s ease;
}

.footer-custom__newsletter-submit:hover {
  background: #c40069;
}

.footer-custom__newsletter-thanks {
  font-size: 0.85rem;
  color: #1a8a3f;
  margin: 4px 0 0;
}

.footer-custom__logo {
  display: block;
  margin-bottom: 12px;
}

.footer-custom__logo img {
  display: block;
  height: auto;
  max-width: 100%;
}

.footer-custom__accordions {
  width: 100%;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  margin-top: 4px;
}

.footer-custom__accordion {
  border-bottom: 1px solid rgba(0, 0, 0, 0.1);
}

.footer-custom__accordion summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 4px;
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #1a1a1a;
}

.footer-custom__accordion summary::-webkit-details-marker {
  display: none;
}

.footer-custom__chevron {
  display: flex;
  transition: transform 0.25s ease;
  color: #1a1a1a;
}

.footer-custom__accordion[open] .footer-custom__chevron {
  transform: rotate(180deg);
}

.footer-custom__accordion-content {
  padding: 0 4px 20px;
  text-align: left;
}

.footer-custom__link-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-custom__link-list a {
  color: #555;
  text-decoration: none;
  font-size: 1rem;
}

.footer-custom__link-list a:hover {
  color: #e5007e;
  text-decoration: underline;
}

.footer-custom__accordion-text {
  font-size: 1rem;
  color: #555;
  line-height: 1.8;
}

.footer-custom__accordion-text a {
  color: #555;
  text-decoration: none;
}

.footer-custom__accordion-text a:hover {
  color: #e5007e;
  text-decoration: underline;
}

.footer-custom__social {
  display: flex;
  justify-content: center;
  gap: 16px;
  margin-top: 28px;
}

.footer-custom__social a {
  color: #1a1a1a;
  display: flex;
}

.footer-custom__social a:hover {
  color: #e5007e;
}

.footer-custom__trust {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
}

.footer-custom__trust-group {
  width: 100%;
  text-align: center;
}

.footer-custom__trust-heading {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #888;
  margin: 0 0 10px;
}

.footer-custom__trust-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 10px;
}

.footer-custom__trust-badge {
  height: 26px;
  width: auto;
  max-width: 60px;
  object-fit: contain;
  border-radius: 4px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background: #fff;
  padding: 2px 4px;
  box-sizing: content-box;
}

.footer-custom__trust-badge--native {
  display: inline-flex;
  align-items: center;
  padding: 0;
  border: 0;
  background: none;
}

.footer-custom__trust-badge--text {
  height: auto;
  max-width: none;
  display: inline-flex;
  align-items: center;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.3px;
  white-space: nowrap;
  border: 0;
  padding: 5px 10px;
}

.footer-custom__trust-badge--native svg {
  height: 26px;
  width: auto;
  border-radius: 4px;
  border: 1px solid rgba(0, 0, 0, 0.08);
}

.footer-custom__bottom {
  margin-top: 32px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}

.footer-custom__copyright {
  font-size: 0.8rem;
  color: #888;
}

.footer-custom__policies-link {
  font-size: 0.8rem;
  color: #888;
  text-decoration: underline;
}

.footer-custom__policies-link:hover {
  color: #e5007e;
}

@media screen and (min-width: 990px) {
  .footer-custom {
    padding: 48px 0 24px;
  }

  .footer-custom__container {
    max-width: 1100px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 0 64px;
    text-align: left;
  }

  .footer-custom__newsletter {
    margin-bottom: 0;
    text-align: center;
    align-self: center;
  }

  .footer-custom__newsletter-form {
    flex-direction: row;
    max-width: none;
    margin: 0 auto;
    justify-content: center;
  }

  .footer-custom__newsletter-submit {
    width: auto;
    flex-shrink: 0;
    padding: 14px 32px;
  }

  .footer-custom__right {
    align-items: flex-start;
  }

  .footer-custom__logo {
    margin: 0 auto 20px;
  }

  .footer-custom__accordion-content {
    text-align: left;
  }

  .footer-custom__social {
    justify-content: flex-start;
  }

  .footer-custom__bottom {
    grid-column: 1 / -1;
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
    margin-top: 24px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer Duki",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 80,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Ancho del logo",
      "default": 180
    },
    {
      "type": "header",
      "content": "Boletín (newsletter)"
    },
    {
      "type": "checkbox",
      "id": "use_newsletter",
      "label": "Mostrar boletín",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título",
      "default": "¡Activa tus ofertas!"
    },
    {
      "type": "richtext",
      "id": "newsletter_subtext",
      "label": "Subtítulo",
      "default": "<p>Suscríbete a nuestro correo y entérate de nuestras novedades y ofertas.</p>"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Placeholder del campo",
      "default": "Correo electrónico"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Texto del botón",
      "default": "Registrarse"
    },
    {
      "type": "text",
      "id": "newsletter_thanks_text",
      "label": "Mensaje de agradecimiento",
      "default": "¡Gracias por suscribirte!"
    },
    {
      "type": "header",
      "content": "Redes sociales"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Mostrar íconos de redes",
      "default": true
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram (URL)"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "TikTok (URL)"
