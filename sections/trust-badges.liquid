{% stylesheet %}
.trust-badges {
  padding: 48px 0;
  background: linear-gradient(180deg, #fff5fa 0%, #ffffff 100%);
}

.trust-badges__container {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  max-width: 1200px;
  margin: 0 auto;
}

.trust-badges__item {
  background: #fff;
  border-radius: 16px;
  padding: 28px 20px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(229, 0, 126, 0.08);
  border: 1px solid rgba(229, 0, 126, 0.08);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.trust-badges__item:hover {
  transform: translateY(-6px);
  box-shadow: 0 12px 28px rgba(229, 0, 126, 0.18);
}

.trust-badges__icon-wrap {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5007e, #ff4fa8);
  box-shadow: 0 6px 16px rgba(229, 0, 126, 0.35);
}

.trust-badges__icon {
  font-size: 28px;
  line-height: 1;
}

.trust-badges__title {
  font-size: 17px;
  font-weight: 800;
  color: #1a1a1a;
  margin: 0 0 8px;
}

.trust-badges__text {
  font-size: 13.5px;
  line-height: 1.5;
  color: #555;
  margin: 0;
}

@media screen and (max-width: 749px) {
  .trust-badges__container {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .trust-badges {
    padding: 32px 0;
  }
}
{% endstylesheet %}

